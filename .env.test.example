# Test-suite settings. Copy to .env.test (git-ignored). Never point this at
# production: conftest refuses any MNEMO_DATABASE_URL without "test" in it.
# Build the DB with scripts/test/build_test_db.sh (pgvector container on 5433).
MNEMO_DATABASE_URL=postgresql://mnemo:mnemo_test_pw@localhost:5433/mnemo_test
